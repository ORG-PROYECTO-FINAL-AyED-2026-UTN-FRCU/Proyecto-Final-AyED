UNIT MENU;
INTERFACE
uses
ARCHIVO_CLIENTES, ARCHIVO_TOOLS//,ARCHIVO_POLIZAS, ARBOL, CLIENTES, POLIZAS, VALIDACION, ESTADÍSTICAS
CRT,SYSUTILS;
//LISTADOS; //LLAMADA A TODAS LAS UNIT NECESARIAS
 PROCEDURE MENU_PRINCIPAL;
IMPLEMENTATION
PROCEDURE MENU_PRINCIPAL;
VAR
 //ARCH_CLIENTES:T_ARCHIVO_CLIENTES;
// ARCH_POLIZAS:T_ARCHIVO_POLIZAS;
// ARBOL_DNI, ARBOL_NOM:T_PUNT;
OPCION: 0..4;
SALIR:BOOLEAN;
BEGIN
//CREAR_ABRIR ARCHIVOS
//GENERAR ARBOLES
SALIR:=FALSE;
repeat
CLRSCR;
GOTOXY(40,10);
WRITELN('1- GESTION DE CLIENTES ');
GOTOXY(40,12);
WRITELN('2- GESTION DE POLIZAS ');
GOTOXY(40,14);
WRITELN('3- LISTADOS ');
GOTOXY(40,16);
WRITELN('4- ESTADISTICAS ');
GOTOXY(40,18);
WRITELN('0- SALIR ');
GOTOXY(40,20);
WRITELN ('INGRESE OPCION: ');READLN(OPCION);
{
CASE OPCION OF
1: CLIENTES (ARCH_CLIENTES, ARBOL_DNI, ARBOL, ARBOL_NOM);
2: POLIZAS (ARCH_CLIENTES, ARCH_POLIZAS, ARBOL_DNI );
3: LISTADOS (ARCH_CLIENTES, ARCH_POLIZAS, ARBOL_NOM);
4: ESTADÍSTICAS (ARCH_CLIENTES,ARCH_POLIZAS);
ELSE
  WRITELN('ERROR, OPCION INVALIDA');
END; }
until OPCION = 0;
READKEY
 END;

END.
